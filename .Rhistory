## Statistics
# volcano plots
plot(StatsPep$`log-ratios 2 vs 1`, -log10(StatsPep$`FDR_limma 2 vs 1`), main = "Volcano plot",
xlab = "log2 fold change", ylab = "-log10 FDR", col = "#AA3333", cex=0.5, pch=15)
plot(Stats$`log-ratios 2 vs 1`, -log10(Stats$`FDR_PolySTest 2 vs 1`), main = "Volcano plot",
xlab = "log2 fold change", ylab = "-log10 FDR", col = "#33AA33", cex=0.5, pch=15)
# # regulated proteins vs ground truth regulation amplitude
# gt_reg <- sapply(Stats$Regulation_Amplitude, function(x) sum(!is.na(as.numeric(unique(unlist(strsplit(x[[1]], ";")))))))
gt_reg_amp <- sapply(Stats$Regulation_Amplitude, function(x) min(as.numeric(unique(unlist(strsplit(x[[1]], ";")))), na.rm=T))
gt_reg_amp[!is.finite(gt_reg_amp)] <- NA
PepsPerProtCut <- PepsPerProt
PepsPerProtCut[PepsPerProtCut > 10] <- 10
combo <- data.frame(gt_reg_amp, FDR = Stats$`FDR_PolySTest 2 vs 1`, PepsPerProtCut)
combo <- combo[order(combo$gt_reg_amp), ]
plot(combo[,1], cumsum(combo[,2] < 0.01), main = "Volcano plot (only ground truth regulated proteins)",
xlab = "log2 fold change (ground truth)", ylab = "Number of proteins with FDR<0.01", type="l")#, col = rainbow(max(PepsPerProtCut))[combo[,3]], cex=0.5, pch=15)
# PCA
hist(Stats[,17], 100)
hist(log2(StatsPep[,18]), 100)
dev.off()

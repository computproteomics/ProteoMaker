sel_i <- c(1, 4, 8)
# Common breaks across selected wrong identification rates
max_fc <- max(sapply(num_reg_prots[sel_i], function(x) max(x[,1], na.rm = TRUE)))
breaks <- seq(0, max_fc + 0.5, by = 0.5)
# Bin labels
bin_labs <- paste0(
head(breaks, -1), "-", tail(breaks, -1)
)
# Count significant proteins per bin and wrong identification rate
count_mat <- sapply(sel_i, function(i) {
x <- num_reg_prots[[i]]
hist(
x[x[,2] < 0.05, 1],
breaks = breaks,
plot = FALSE
)$counts
})
colnames(count_mat) <- names(num_reg_prots)[sel_i]
rownames(count_mat) <- bin_labs
count_mat

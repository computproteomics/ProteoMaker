MeanAndSd <- function(x, na.rm = FALSE) {
av <- mean(x, na.rm = na.rm)
sdev <- sd(x, na.rm = na.rm)
c(
mean = av,
sd = sdev
)
}
MeanAndSd(1:1000)
MeanAndSd(c(NA,1:1000))
MeanAndSd(c(NA,1:1000), na.rm=TRUE)
MeanAndSd()
MeanAndSd <- function(
x = rnorm(20),
na.rm = TRUE
) {
c(
mean = mean(x, na.rm = na.rm),
sd = sd(x, na.rm = na.rm)
)
}
MeanAndSd()

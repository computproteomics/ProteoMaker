redbenchs <- matrix(NA, nrow = length(runs),
ncol = 40,
dimnames = list(runs, c("FracModProt","IncludeModPep","NumTotProt", "NumTotPep",
"NumProtG1", "NumPepG1", "meanSquareDiffFCProtMin2",
"meanSquareDiffFCPepMin2","sdWithinRepsProtMin2","sdWithinRepsPepMin2",
paste0(rep(c("numProt","numPep",
"meanSquareDiffFCProt","meanSquareDiffFCPep",
"sdWithinRepsProt","sdWithinRepsPep"), each=5),
rep(1:5, 6)))))
for (i in seq_len(length(runs))) {
load(paste0("tmp/outputDataAnalysis_", runs[i], ".RData"))
id_ptm <- table(data.frame(CorrectID=!StatsPep$WrongID, hasPTM=sapply(StatsPep$PTMType, function(x) length(x) > 0)))
all_id_ptms[i, 3:6] <- as.vector(id_ptm[c(3,4,1,2)])
has_multi_prot <- sapply(Stats$Proteoform_ID, function(x) length(unique(unlist(strsplit(x, ";")))))
has_multi_pep <- sapply(StatsPep$Proteoform_ID, function(x) length(unique(unlist(x))))
redbenchs[i, 1:4] <- c(benchs[benchs$X == runs[i], "FracModProt"][1], benchs[benchs$X == runs[i], "IncludeModPep"][1],
nrow(Stats), nrow(StatsPep))
# Proteins and peptides with multiple proteoforms
for (j in 1:5) {
c_prot <- Stats[has_multi_prot == j, ]
c_pep <- StatsPep[has_multi_pep == j, ]
if(nrow(c_pep) < 10) next
t_newbench <- ProteoMaker:::calcBenchmarks(c_prot, c_pep, Param)
redbenchs[i, 10+j] <- nrow(c_prot)
redbenchs[i, 15+j] <- nrow(c_pep)
redbenchs[i, 20+j] <- t_newbench$globalBMs$meanSquareDiffFCProt
redbenchs[i, 25+j] <- t_newbench$globalBMs$meanSquareDiffFCPep
redbenchs[i, 30+j] <- t_newbench$globalBMs$sdWithinRepsProt
redbenchs[i, 35+j] <- t_newbench$globalBMs$sdWithinRepsPep
}
c_prot <- Stats[has_multi_prot > 1, ]
c_pep <- StatsPep[has_multi_pep > 1, ]
if(nrow(c_prot) < 50) next
t_newbench <- ProteoMaker:::calcBenchmarks(c_prot, c_pep, Param)
redbenchs[i, 5:6] <- c(nrow(c_prot), nrow(c_pep))
redbenchs[i, 7:8] <- c(t_newbench$globalBMs$meanSquareDiffFCProt, t_newbench$globalBMs$meanSquareDiffFCPep)
redbenchs[i, 9:10] <- c(t_newbench$globalBMs$sdWithinRepsProt, t_newbench$PepStats$sdWithinRepsPep)
}
